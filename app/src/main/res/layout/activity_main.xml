<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111318">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CR AI Trainer · Android"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="봇전/연습전용 · 화면 캡처 → TFLite 카드 인식 → 엘릭서/패 추적"
            android:textColor="#BFC5D0"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="상대 8장 덱 (모델 class label과 동일, 쉼표 구분)"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/deckInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#20242C"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A93A3"
            android:hint="hog_rider,musketeer,..." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="엘릭서 비용 (label=cost, 쉼표 구분)"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/costInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#20242C"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A93A3"
            android:hint="hog_rider=4,musketeer=4,..." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="x1에서 엘릭서 1개가 차는 시간(초)"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/secPerElixirInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#20242C"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:text="2.8" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="설정 저장" />

        <Button
            android:id="@+id/overlayPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="1. 다른 앱 위에 표시 권한" />

        <Button
            android:id="@+id/startCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="2. 화면 캡처 시작" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="추적 중지" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="12dp"
            android:background="#20242C"
            android:textColor="#67E8A5"
            android:text="상태: 대기" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#9EA7B6"
            android:textSize="13sp"
            android:text="중요: app/src/main/assets/best.tflite가 없으면 캡처/HUD는 실행되지만 AI 검출은 비활성화됩니다. 모델을 넣고 다시 빌드하세요." />

    </LinearLayout>
</ScrollView>
